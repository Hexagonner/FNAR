[sub_resource type="GDScript" id="GDScript_864kv"]
resource_name = "startmenu_cam"
script/source = "extends Camera3D
@export var target:Node3D
@export var depth:float = 1.0
func _process(_delta):
	# 1. 뷰포트에서 마우스의 2D 절대 좌표를 가져옵니다.
	var mouse_pos_2d = get_viewport().get_mouse_position()
	
	# 2. 깊이(Depth) 지정하기
	# 화면 바로 앞(렌더링이 시작되는 최소 거리)의 3D 좌표를 원하시면 'near'를 사용합니다.
	# 카메라 앞 1미터 지점을 원하시면 1.0을 넣으시면 됩니다.
	
	
	# 3. 2D 좌표를 3D 월드 좌표로 변환 (project_position)
	var mouse_world_pos_3d = project_position(mouse_pos_2d, depth)
	
	# 4. [선택] 만약 '월드' 기준이 아니라 정말 '카메라 노드' 기준의 상대 좌표가 필요하다면:
	#var mouse_local_pos_3d = to_local(mouse_world_pos_3d)
	
	# 디버깅 출력
	#print(\"월드 3D 좌표: \", mouse_world_pos_3d)
	#print(\"카메라 기준 상대 3D 좌표: \", mouse_local_pos_3d)
	target.global_position = mouse_world_pos_3d
	#print(target.global_position)
"

