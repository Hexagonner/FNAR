resource_name = "inf_bat"
script/source = "extends CheckBox

func _ready() -> void:
	self.button_pressed = GameManager.inf_bat



@warning_ignore(\"unused_parameter\")
func _on_toggled(toggled_on: bool) -> void:
	GameManager.inf_bat = toggled_on
"

[sub_resource type="GDScript" id="GDScript_ygvjo"]
resource_name = "motion_blur_setting"
script/source = "extends CheckBox


func _ready() -> void:
	self.button_pressed = GlobalSetting.is_motion_blur
	


func _on_toggled(toggled_on: bool) -> void:
	GlobalSetting.is_motion_blur = toggled_on
"

[sub_resource type="GDScript" id="GDScript_yxbet"]
resource_name = "low_spec_mod"
script/source = "extends CheckBox



func _ready() -> void:
	self.button_pressed = SaveManager.get_value(\"low_spec_mode\")
	


func _on_toggled(toggled_on: bool) -> void:
	GlobalSetting.low_spec_mode = toggled_on
	SaveManager.set_value(\"low_spec_mode\", toggled_on)
	if toggled_on:
		ProjectSettings.set_setting(\"rendering/scaling/3d_scale\", 0.2)
		ProjectSettings.set_setting(\"rendering/lights_and_shadows/directional_shadow/soft_shadow_filter_quality\",1)
		ProjectSettings.set_setting(\"rendering/lights_and_shadows/positional_shadow/soft_shadow_filter_quality\",1)
		ProjectSettings.set_setting(\"application/run/low_processor_mode\", 1)
	else:
		ProjectSettings.set_setting(\"rendering/scaling/3d_scale\", 1)
		ProjectSettings.set_setting(\"rendering/lights_and_shadows/directional_shadow/soft_shadow_filter_quality\",2)
		ProjectSettings.set_setting(\"rendering/lights_and_shadows/positional_shadow/soft_shadow_filter_quality\",2)
		ProjectSettings.set_setting(\"application/run/low_processor_mode\", 0)
"

[sub_resource type="GDScript" id="GDScript_o2tps"]
resource_name = "reset_button"
script/source = "extends Button

@export var progress:ProgressBar
@export var progress_speed:int = 30
@export var sound:AudioStreamPlayer
@export var timer:Timer
@export var fadeout:ColorRect
var is_button_pressed = false
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if is_button_pressed:
		progress.value += progress_speed * delta
		fadeout.color.a += 0.29 * delta
	if progress.value == 100:
		self.disabled = true
		progress.value = 0
		self.text = \"초기화 완료\"
		SaveManager.saveData(SaveManager.reset_file)
		timer.stop()
		get_tree().reload_current_scene()


func _on_button_down() -> void:
	is_button_pressed = true
	print(\"pressing\")
	self.text = \"꾹 누르세요\"
	sound.play(0.0)
	timer.stop()
func _on_button_up() -> void:
	is_button_pressed = false
	progress.value = 0.0
	timer.start(0)
	print(\"out\")
	sound.stop()
	fadeout.color.a = 0
func _on_timer_timeout() -> void:
	self.text = \"세이브 초기화\"
"

