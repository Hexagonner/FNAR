[sub_resource type="GDScript" id="GDScript_y4icf"]
script/source = "extends SpinBox

#var data = SaveManager.loadData()
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	self.max_value = clamp(SaveManager.get_value(\"clear_night\")+1, 1, 5)
	value =clamp(SaveManager.get_value(\"clear_night\")+1, 1, 5)
	var line_edit = get_line_edit()
	
	# 우클릭 컨텍스트 메뉴를 비활성화합니다.
	line_edit.context_menu_enabled = false
"

[sub_resource type="GDScript" id="GDScript_8v8wu"]
resource_name = "version_button"
script/source = "extends Button


func _on_pressed() -> void:
	OS.shell_open(\"https://github.com/Hexagonner/FNAR\") #TODO 나중에  깃헙등에 연 동   
func _ready() -> void:
	self.text =\"@ \"+ ProjectSettings.get_setting(\"application/config/version\")+\"V\"
	if OS.is_debug_build():
		self.text += \" (디버깅 모드)\"
"

