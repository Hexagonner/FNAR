[sub_resource type="GDScript" id="GDScript_4w2wx"]
resource_name = "anti_alia"
script/source = "extends OptionButton

@onready var viewport = get_tree().root.get_viewport()

var anti_alias_menu:Dictionary = {
	\"끄기\":0,
	\"FXAA\": 1,
	\"MSAA_2X\": 2,
	\"MSAA_4X\": 4,
	\"MSAA_8X\": 8,
}
func _ready() -> void:
	for list in anti_alias_menu:
		self.add_item(list)
	if viewport.screen_space_aa == Viewport.SCREEN_SPACE_AA_FXAA:
		select(1)
	elif viewport.msaa_3d == Viewport.MSAA_2X:
		select(2)
	elif viewport.msaa_3d == Viewport.MSAA_4X:
		select(4)
	elif viewport.msaa_3d == Viewport.MSAA_8X:
		select(8)
	elif viewport.msaa_3d == Viewport.MSAA_DISABLED and Viewport.SCREEN_SPACE_AA_DISABLED:
		select(0)
func _on_item_selected(index: int) -> void:
	
	match index:
		0:
			viewport.msaa_3d = Viewport.MSAA_DISABLED
			viewport.screen_space_aa = Viewport.SCREEN_SPACE_AA_DISABLED
		1:
			viewport.msaa_3d = Viewport.MSAA_DISABLED
			viewport.screen_space_aa = Viewport.SCREEN_SPACE_AA_FXAA
		2:
			viewport.screen_space_aa = Viewport.SCREEN_SPACE_AA_DISABLED
			viewport.msaa_3d = Viewport.MSAA_2X
		4:
			viewport.screen_space_aa = Viewport.SCREEN_SPACE_AA_DISABLED
			viewport.msaa_3d = Viewport.MSAA_4X
		8:
			viewport.screen_space_aa = Viewport.SCREEN_SPACE_AA_DISABLED
			viewport.msaa_3d = Viewport.MSAA_8X
"

