[sub_resource type="GDScript" id="GDScript_ih1pi"]
resource_name = "Left_button_container"
script/source = "extends HBoxContainer

#var data = SaveManager.loadData()
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if SaveManager.get_value(\"clear_night\") >= 5:
		$VBoxContainer/Night6.visible = true
		$VBoxContainer/Custom.visible = true
	else:
		$VBoxContainer/Night6.visible = false
		$VBoxContainer/Custom.visible = false
"

