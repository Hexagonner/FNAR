[sub_resource type="GDScript" id="GDScript_lrwol"]
script/source = "extends AnimationPlayer
@onready var timer = $Timer
var light_flicker_chance



func _on_timer_timeout() -> void:
	if randf_range(1,10) >6  and not is_playing():
		play(\"flicker\")
		timer.wait_time =int(randf_range(2,5))
		timer.start(0)
"

