[sub_resource type="GDScript" id="GDScript_qbdri"]
resource_name = "fadein"
script/source = "extends ColorRect

@onready var color_rect = self

func _ready():
	visible = true
	# ColorRect 초기 설정 (검은색, 완전히 불투명)
	color_rect.modulate = Color(0, 0, 0, 1)  # R, G, B, A (A=1)

	# SceneTreeTween 생성
	var tween = create_tween()
	tween.tween_property(color_rect,\"modulate:a\",0.0,1.5).set_trans(Tween.TRANS_SINE)
	
	# 트윈 완료 시 ColorRect 삭제
	tween.finished.connect(_on_tween_finished)


func _on_tween_finished():
	if is_instance_valid(color_rect):
		queue_free()  # ColorRect 삭제
"

